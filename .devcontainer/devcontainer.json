{
    "image": "ubuntu:26.04",
    "features": {
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": "git,npm"
        },
        "ghcr.io/devcontainers-extra/features/pre-commit:2": {}
    },
    "onCreateCommand": {
        "install-devcont-cli": "npm install --no-save @devcontainers/cli "
    },
    "postStartCommand": {
        "init-precommit-envs": "pre-commit install-hooks"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/usr/local/py-utils/bin:${containerWorkspaceFolder}/node_modules/.bin"
    }
}
