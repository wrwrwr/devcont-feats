{
    "image": "ubuntu:26.04",
    "features": {
        "ghcr.io/wrwrwr/devcont-feats/apt-install:0": {
            "packages": "git,npm,pipx"
        },
        "ghcr.io/wrwrwr/devcont-feats/pipx-install:0": {
            "packages": "prek"
        }
    },
    "postStartCommand": {
        "init-prek-environs": "prek install-hooks",
        "install-devcont-cli": "npm install --no-save @devcontainers/cli"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/node_modules/.bin"
    }
}
