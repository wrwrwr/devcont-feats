{
    "name": "Add user",
    "id": "add-user",
    "version": "0.0.3",
    "description": "Creates a user with the specified name and id.",
    "options": {
        "name": {
            "type": "string",
            "proposals": [
                "dev",
                "devcont"
            ],
            "default": "",
            "description": "New user name; 'remoteUser' by default."
        },
        "userId": {
            "type": "string",
            "proposals": [
                "1111",
                "1234"
            ],
            "default": "1111",
            "description": "New user/group id (match in-container mounts uid)."
        }
    }
}
