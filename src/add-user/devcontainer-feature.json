{
    "name": "Add user",
    "id": "add-user",
    "version": "0.0.6",
    "description": "Creates a user with the specified name and IDs.",
    "options": {
        "name": {
            "type": "string",
            "proposals": [
                "dev",
                "devcont"
            ],
            "default": "",
            "description": "New user name; 'remoteUser' by default."
        },
        "userId": {
            "type": "string",
            "proposals": [
                "1111",
                "1234"
            ],
            "default": "1111",
            "description": "New user id (match in-container mounts uid)."
        },
        "groupId": {
            "type": "string",
            "proposals": [
                "1111",
                "1234"
            ],
            "default": "",
            "description": "New group id; 'userId' by default."
        },
        "shell": {
            "type": "string",
            "proposals": [
                "/bin/bash",
                "/bin/zsh"
            ],
            "default": "/bin/bash",
            "description": "Login shell (not auto-installed)."
        }
    }
}
