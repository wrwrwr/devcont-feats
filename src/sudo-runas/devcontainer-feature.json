{
    "name": "Sudo run-as",
    "id": "sudo-runas",
    "version": "0.0.2",
    "description": "Allows a user to execute a command as another user.",
    "options": {
        "invoker": {
            "type": "string",
            "proposals": [
                "ubuntu",
                "dev"
            ],
            "default": "",
            "description": "The user to be allowed; 'remoteUser' by default."
        },
        "executor": {
            "type": "string",
            "proposals": [
                "root",
                "postgres"
            ],
            "default": "root",
            "description": "The user to delegate to (sudo --user <user>)."
        },
        "command": {
            "type": "string",
            "proposals": [
                "/usr/bin/apt install zsh",
                "/usr/sbin/service postgresql start",
                "/usr/sbin/update-ca-certificates \\\"\\\"",
