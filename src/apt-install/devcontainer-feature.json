{
    "name": "Install using APT",
    "id": "apt-install",
    "version": "0.0.5",
    "description": "Installs packages assuming apt is available.",
    "options": {
        "name": {
            "type": "string",
            "proposals": [
                "git",
                "git,sudo"
            ],
            "default": "",
            "description": "Comma-separated list of package names."
        }
    },
    "installsAfter": [
        "ghcr.io/wrwrwr/devcont-feats/apt-https"
    ]
}
